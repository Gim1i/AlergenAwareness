.Background {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    top: 0;
    background-image: url("project://database/Assets/Gameplay/Sprites/Temporary_Background.png?fileID=2800000&guid=ed1327232170ad24db172060635d32e6&type=3#Temporary_Background");
}

.Backgrounds-Background {
    left: 0;
    bottom: 0;
    right: 0;
    top: 0;
    position: absolute;
    background-color: rgb(0, 0, 0);
}

.TextBox {
    height: 20%;
    top: auto;
    position: absolute;
    margin: 0;
    padding: 3%;
    -unity-font-definition: url("project://database/Assets/Gameplay/Fonts/ttf%20files/Main%20(1%20Cataneo%20BT%20Regular).ttf?fileID=12800000&guid=037fc5ad33fcc07aebc0827251b72a49&type=3#Main (1 Cataneo BT Regular)");
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    font-size: 350%;
    white-space: normal;
    width: 97.92%;
    align-self: center;
    right: auto;
    left: auto;
    bottom: 0.5%;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.918);
    background-image: url("project://database/Assets/Gameplay/Sprites/TextBoxes.png?fileID=-770086865&guid=1cd11fcdd3f221d4bb35294cfbc77ef2&type=3#TextBoxes_3");
}
