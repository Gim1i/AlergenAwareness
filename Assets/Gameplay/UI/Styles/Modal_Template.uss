.Background {
    flex-grow: 1;
    background-image: url("project://database/Assets/Gameplay/Sprites/Modal%20Sprites/Border.png?fileID=2800000&guid=ed318b95217ca2c3b8660d13e58c6788&type=3#Border");
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.ModalState {
    flex-grow: 1;
    bottom: 12.5%;
    right: 12.5%;
    top: 12.5%;
    left: 12.5%;
    position: absolute;
}

.HoverLabel {
    right: 3%;
    left: 3%;
    position: absolute;
    -unity-font-definition: url("project://database/Assets/Gameplay/Fonts/ttf%20files/Main%20(1%20Cataneo%20BT%20Regular).ttf?fileID=12800000&guid=037fc5ad33fcc07aebc0827251b72a49&type=3#Main (1 Cataneo BT Regular)");
    color: rgb(0, 0, 0);
    font-size: 13px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    white-space: normal;
    -unity-text-auto-size: best-fit 10px 100px;
    -unity-text-generator: advanced;
    top: 8%;
    bottom: 3%;
    -unity-text-align: upper-center;
    visibility: hidden;
}
